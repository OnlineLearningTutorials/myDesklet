{
    "head0": {
        "type": "header",
        "description": "Settings for Battery Charging desklet"
    },
    "head1": {
        "type": "header",
        "description": "General"
    },
    "low-threshold": {
        "type": "spinbutton",
        "default": 15,
        "min": 5,
        "max": 40,
        "step": 1,
        "units": "%",
        "description": "Low battery threshold",
        "tooltip": "Change color when battery is below this level"
    },
    "refresh-interval": {
        "type": "spinbutton",
        "default": 2,
        "step": 1,
        "min": 1,
        "max": 30,
        "units": "seconds",
        "description": "Refresh interval"
    },
    "head2": {
        "type": "header",
        "description": "Layout"
    },
    "design": {
        "type": "combobox",
        "default": "thick",
        "description": "Design",
        "options": {
            "Thin": "thin",
            "Compact": "compact",
            "Thick": "thick"
        }
    },
    "scale-size": {
        "type": "spinbutton",
        "default": 1.0,
        "min": 0.4,
        "max": 5.0,
        "step": 0.05,
        "units": "scale factor",
        "description": "Desklet size"
    },
    "text-view": {
        "type": "combobox",
        "default": "per_only",
        "description": "Text display",
        "options": {
            "Percentage Only": "per_only",
            "Percentage / Status": "per_status",
            "Percentage / Time Remaining": "per_remtime"
        }
    },
    "head3": {
        "type": "header",
        "description": "Colors"
    },
    "font-color": {
        "type": "colorchooser",
        "default": "rgba(255,255,255,1.0)",
        "description": "Font color"
    },
    "use-custom-color": {
        "type": "checkbox",
        "description": "Use custom circle color",
        "default": false
    },
    "circle-color": {
        "type": "colorchooser",
        "default": "rgba(83,199,160,1.0)",
        "description": "Circle color"
    },
    "low-battery-color": {
        "type": "colorchooser",
        "default": "rgba(255,0,0,1.0)",
        "description": "Low battery color"
    },
    "show-background": {
        "type": "checkbox",
        "description": "Show background circle",
        "default": true
    },
    "hide-decorations": {
        "type": "checkbox",
        "description": "Hide decorations",
        "default": false
    },
    "devfile_capacity": {
        "default": "", 
        "type": "filechooser", 
        "description" : "Path to battery capacity file",
        "allow-none" : true
    },
    "devfile_status": {
        "default": "", 
        "type": "filechooser", 
        "description" : "Path to battery status file",
        "allow-none" : true
    }
}
