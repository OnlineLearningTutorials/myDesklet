{
    "layout": {
        "type": "layout",
        "pages": ["page1"],
        "sections": ["section1"]
    },
    "page1": {
        "type": "page",
        "title": "Temperature Settings",
        "sections": ["section1"]
    },
    "section1": {
        "type": "section",
        "title": "Appearance",
        "keys": ["displaystyle", "scale-size", "update-interval"]
    },
    "displaystyle": {
        "type": "combobox",
        "default": "speedometer",
        "description": "Display Style",
        "options": {
            "Speedometer": "speedometer",
            "Thermometer": "thermometer"
        }
    },
    "scale-size": {
        "type": "spinbutton",
        "default": 1.0,
        "min": 0.5,
        "max": 3.0,
        "step": 0.1,
        "description": "Scale Size"
    },
    "update-interval": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 60,
        "step": 1,
        "units": "seconds",
        "description": "Update Interval"
    }
}
